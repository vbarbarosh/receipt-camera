#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

BLACK="\e[30m" RED="\e[31m" GREEN="\e[32m" YELLOW="\e[33m" BLUE="\e[34m"
PURPLE="\e[35m" CYAN="\e[36m" WHITE="\e[37m" RESET="\e[0m"

EXIT_MESSAGE="${RED}src/android/bin/build failed${RESET}"

# http://redsymbol.net/articles/bash-exit-traps/
# http://redsymbol.net/articles/unofficial-bash-strict-mode/#essential-cleanup
tempdir=`mktemp -d -t tmp.XXXXXXXXXX`
trap 'rm -rf $tempdir; echo -e "$EXIT_MESSAGE"' EXIT
cd $tempdir

cd $scriptdir/..

# builds receipt-camera.apk without Gradle: aapt2 -> javac -> d8 -> zipalign -> apksigner

ROOT=$PWD
ANDROID=${ANDROID:-$ROOT/toolchain}
BT=$ANDROID/sdk/build-tools/34.0.0
PLATFORM=$ANDROID/sdk/platforms/android-34/android.jar
export PATH=$ANDROID/jdk/bin:$PATH
OUT=$ROOT/build

rm -rf "$OUT"
mkdir -p "$OUT/classes" "$OUT/dex"

"$BT/aapt2" compile --dir "$ROOT/res" -o "$OUT/res.zip"
"$BT/aapt2" link -I "$PLATFORM" --manifest "$ROOT/AndroidManifest.xml" -o "$OUT/base.apk" "$OUT/res.zip"

javac -encoding UTF-8 -source 1.8 -target 1.8 \
    -bootclasspath "$PLATFORM:$BT/core-lambda-stubs.jar" -d "$OUT/classes" \
    $(find "$ROOT/src" -name '*.java')

"$BT/d8" --release --lib "$PLATFORM" --output "$OUT/dex" \
    $(find "$OUT/classes" -name '*.class')

(cd "$OUT/dex" && zip -q -X "$OUT/base.apk" classes.dex)

"$BT/zipalign" -f 4 "$OUT/base.apk" "$OUT/aligned.apk"

if [ ! -f "$ROOT/keystore" ]; then
    keytool -genkeypair -keystore "$ROOT/keystore" -storepass receiptdrop -keypass receiptdrop \
        -alias receiptcamera -dname CN=ReceiptCamera -keyalg RSA -keysize 2048 -validity 10000
fi

"$BT/apksigner" sign --ks "$ROOT/keystore" --ks-pass pass:receiptdrop --key-pass pass:receiptdrop \
    --out "$ROOT/receipt-camera.apk" "$OUT/aligned.apk"

"$BT/aapt2" dump badging "$ROOT/receipt-camera.apk" \
    | sed -n "s/.*versionCode='\([0-9]*\)'.*/\1/p" | head -1 > "$ROOT/apk-version.txt"

ls -la "$ROOT/receipt-camera.apk"
echo "apk-version: $(cat "$ROOT/apk-version.txt")"

EXIT_MESSAGE="${GREEN}src/android/bin/build succeeded${RESET}"
